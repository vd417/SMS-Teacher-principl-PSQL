{
  "expo": {
    "name": "School Desk Teacher App",
    "slug": "school-desk-teacher-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0129"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.catre.schooldeskteacher",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow School Desk to use your location to verify you are at school when you check in."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "64431794-8eea-4172-b4d4-d7ce4a5a813f"
      }
    },
    "owner": "catre"
  }
}
